   "body": "{\"status\":true,\"msg\":\"\",\"Data\":[{\"programid\":\"0000988\",\"cname\":\"沙丘：第三部\",\"ename\":\"Dune: Part Three\",\"ReleaseDate\":\"2026-12-15\",\"filmlevel\":\"movie-level s-font\",\"CodeName\":\"未定\",\"ShowTimes\":\"151\",\"Director\":\"丹尼維勒納夫\",\"Actors\":\"提摩西夏勒梅、蕾貝卡弗格森、辛蒂亞\",\"Introduction\":\"《沙丘：第三部》故事背景發生在保羅亞崔迪奪取帝國統治權的近二十年之後。如今已成為冷酷皇帝的保羅，在昔日盟友重現、可怕的新威脅接踵而至，而背叛的陰影更潛伏在每個角落之際，保羅必須面對他極權統治所帶來的後果。帝國崩塌的幻象與不幸身亡的愛人重現的交織景象不斷地困擾著保羅，將他捲入一場縝密又宏大的陰謀之中，而荃妮正是這重重謎團中的核心人物。隨著叛亂暗流湧動、強敵步步緊逼，保羅必須面對終極權力的真正代價，以及他摯愛之人的命運。\",\"image\":\"https://www.broadway-cineplex.com.tw/uploads/0000988.jpg\",\"SubName2\":\"數位/英文\",\"datedata\":[{\"date\":\"2026-12-15\",\"日期\":\"12.15\",\"星期\":\"星期二\",\"active\":true},{\"date\":\"2026-12-16\",\"日期\":\"12.16\",\"星期\":\"星期三\",\"active\":false},{\"date\":\"2026-12-17\",\"日期\":\"12.17\",\"星期\":\"星期四\",\"active\":false},{\"date\":\"2026-12-18\",\"日期\":\"12.18\",\"星期\":\"星期五\",\"active\":false},{\"date\":\"2026-12-19\",\"日期\":\"12.19\",\"星期\":\"星期六\",\"active\":false},{\"date\":\"2026-12-20\",\"日期\":\"12.20\",\"星期\":\"星期日\",\"active\":false},{\"date\":\"2026-12-21\",\"日期\":\"12.21\",\"星期\":\"星期一\",\"active\":false}],\"timedata\":[{\"SubName2\":\"數位/英文\",\"subtimedata\":[{\"SubCode\":\"DIGENGCHT\",\"SubName2\":\"數位/英文\",\"時間\":\"15:00\",\"hall\":\"0010\",\"hallname\":\"10廳\",\"active\":false,\"disable\":false,\"showdate\":\"2026-12-15\"},{\"SubCode\":\"DIGENGCHT\",\"SubName2\":\"數位/英文\",\"時間\":\"17:55\",\"hall\":\"0010\",\"hallname\":\"10廳\",\"active\":false,\"disable\":false,\"showdate\":\"2026-12-15\"},{\"SubCode\":\"DIGENGCHT\",\"SubName2\":\"數位/英文\",\"時間\":\"20:50\",\"hall\":\"0010\",\"hallname\":\"10廳\",\"active\":false,\"disable\":false,\"showdate\":\"2026-12-15\"}]}]}]}"
