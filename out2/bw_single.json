}\r\n    </style>\r\n</head>\r\n\r\n<body id=\"app\">\r\n    <div id=\"broadapp\">\r\n        <!-- header -->\r\n        <header>\r\n            <nav id=\"nav\">\r\n                <input type=\"checkbox\" id=\"hamberger-menu\" class=\"input-toggler\" />\r\n                <div class=\"sidebar-overlay\"></div>\r\n                <label for=\"hamberger-menu\" class=\"menu-toggler\">\r\n                    <span class=\"menu-toggler-line\"></span>\r\n                    <span class=\"menu-toggler-line\"></span>\r\n                    <span class=\"menu-toggler-line\"></span>\r\n                </label>\r\n                <div class=\"sidebar\">\r\n                    <!-- navbar logo -->\r\n                    <a class=\"nav-brand\" href=\"index.html\">\r\n                        <img src=\"image/01_index_01_logo.png\" alt=\"百老匯影城LOGO\">\r\n                    </a>\r\n                    <!-- navbar menu  -->\r\n                    <div class=\"nav-menu\">\r\n                        <ul class=\"menu\">\r\n                            <li>\r\n                                <div class=\"menu-link\">線上訂票</div>\r\n                                <ul class=\"dropdown-menu\">\r\n                                    <li v-for=\"(item,index) in classdata\"><a class=\"dropdown-item\" v-bind:href=\"'book.html?obj='+item.item_value + '&v25080101'\" :title=\"item.item_name\">{{item.item_name}}</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"ticket-price.html\" title=\"影城票價\">影城票價</a></li>\r\n                                </ul>\r\n                            </li>\r\n                            <li>\r\n                                <div class=\"menu-link\">電影介紹</div>\r\n                                <ul class=\"dropdown-menu\">\r\n                                    <li><a class=\"dropdown-item\" href=\"movies.html?obj=R\" title=\"現正熱映\">現正熱映</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"movies.html?obj=C\" title=\"近期上映\">近期上映</a></li>\r\n                                </ul>\r\n                            </li>\r\n                            <li><a class=\"menu-link\" href=\"news.html\" title=\"最新消息\">最新消息</a></li>\r\n                            <li><a class=\"menu-link\" href=\"group-ticket.html\" title=\"業務專區\">業務專區</a></li>\r\n                            <li>\r\n                                <div class=\"menu-link\">關於影城</div>\r\n                                <ul class=\"dropdown-menu\">\r\n                                    <li><a class=\"dropdown-item\" href=\"about.html\" title=\"影城介紹\">影城介紹</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"contact.html\" title=\"聯繫我們\">聯繫我們</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"privacy.html\" title=\"隱私權保護政策\">隱私權保護政策</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"bookInfo.html\" title=\"線上訂票須知\">線上訂票須知</a></li>\r\n                                    <li><a class=\"dropdown-item\" href=\"rating.html\" title=\"電影分級制度說明\">電影分級制度說明</a></li>\r\n                                </ul>\r\n                            </li>\r\n                        </ul>\r\n                        <!-- user-account add/remove class 'isUser' trigger login/out layout  -->\r\n                        <div class=\"user-account\" v-bind:class=\"{'isUser':login==='Y'}\">\r\n                            <div class=\"user\">\r\n                                您好!<span class=\"user-name\">{{username}}</span><span class=\"svg-icons i-person\"></span><span class=\"svg-icons i-menu\"></span>\r\n                            </div>\r\n                            <div class=\"account-sub\">\r\n                                <hr />\r\n                                <a href=\"book-history.html\" title=\"訂票查詢與取消\">訂票查詢與取消</a>\r\n                                <a href=\"account.html\" title=\"會員資料\">會員資料</a>\r\n                                <a href=\"discount.html\" title=\"會員優惠PLUS\">會員優惠PLUS</a>\r\n                                <a title=\"登出\" v-on:click=\"logout();\">登出</a>\r\n                            </div>\r\n                            <div class=\"user-login\">\r\n                                <a href=\"login.html?obj=l&obj1=b\" title=\"會員登入\">會員登入</a>\r\n                            </div>\r\n                            <div class=\"user-regist\">\r\n                                <a href=\"login.html?obj=m&obj1=b\" title=\"加入會員\">加入會員</a>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </nav>\r\n        </header>\r\n        <!-- main container -->\r\n        <main class=\"section-box\">\r\n            <section class=\"section\">\r\n                <div class=\"content booking\">\r\n                    <div class=\"main-title l-font\">\r\n                        <div class=\"\">SESSION TIMES</div>\r\n                        <div>場次資訊</div>\r\n                    </div>\r\n                    <div class=\"actions\">\r\n                        <button class=\"actions-btn tab-item\" :class=\"{'active': 選擇影城===item.item_value}\" v-for=\"(item,index) in classdata\" v-on:click=\"changetheater(item)\">{{item.item_name}}</button>\r\n                    </div>\r\n                    <div class=\"tab-content\" v-if=\"moviesdata == null || moviesdata.length <= 0\"></div>\r\n                    <div class=\"tab-content\" v-else>\r\n                        <div class=\"content-row\" v-for=\"(item,index) in moviesdata\">\r\n                            <div class=\"row-left row-6\">\r\n                                <div class=\"movie-item row-4 item-img\">\r\n                                    <img :src=\"item.image\" alt=\"movie-name\" />\r\n                                    <a v-bind:href=\"'movie-info.html?obj='+item. programid\" class=\"more s-font\"><span class=\"svg-icons i-more\"></span>更多電影介紹</a>\r\n                                </div>\r\n                                <div class=\"movie-item row-6 item-info\">\r\n                                    <div v-bind:class=\"[item.filmlevel]\"></div>\r\n                                    <div class=\"movie-title\">\r\n                                        <p class=\"l-font\">{{item.cname}}</p>\r\n                                        <span>{{item.ename}}</span>\r\n                                    </div>\r\n                                    <div class=\"up-date\">上映日期 {{item.ReleaseDate}}</div>\r\n                                    <div class=\"list-item\">\r\n                                        <div class=\"list-row\"><span>導演</span><span>{{item.Director}}</span></div>\r\n                                        <div class=\"list-row\">\r\n                                            <span>演員</span><span>{{item.Actors}}</span>\r\n                                        </div>\r\n                                        <div class=\"list-row\"><span>類型</span><span>{{item.CodeName}}</span></div>\r\n                                        <div class=\"list-row\"><span>片長</span><span>{{item.ShowTimes}}分鐘</span></div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"row-right row-4\">\r\n                                <div class=\"weektable\">\r\n                                    <div class=\"booktime\" v-bind:class=\"{active:item1.active}\" v-for=\"(item1,index) in item.datedata\" v-on:click=\"selectdate(item1,item.datedata,item)\">{{item1.日期}}<span>{{item1.星期}}</span></div>\r\n                                </div>\r\n                                <div v-for=\"(item2,index) in item.timedata\">\r\n                                    <div class=\"cinema\">\r\n                                        <span class=\"svg-icons i-video\"></span>{{item2.SubName2}}\r\n                                    </div>\r\n                                    <div class=\"timetable\">\r\n                                        <div class=\"time\" v-bind:class=\"{active:item3.active, disable:item3.disable}\" v-for=\"(item3,index) in item2.subtimedata\"\r\n                                             v-on:click=\"selecttime(item3,item.timedata)\"><span>{{item3.時間}}</span></div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"actions\">\r\n                                    <button class=\"quick-view\" v-on:click=\"viewseat(item);\">\r\n                                        <a>\r\n                                            <span><small>QUICK VIEW</small>預覽座位</span>\r\n                                            <span class=\"svg-icons i-chair-white\"></span>\r\n                                        </a>\r\n                                    </button>\r\n                                    <button class=\"buy-ticket\" v-on:click=\"bookseat(item);\">\r\n                                        <a>\r\n                                            <span><small>BUY TICKET</small>前往訂票</span>\r\n                                            <span class=\"svg-icons i-ticket-white\"></span>\r\n                                        </a>\r\n                                    </button>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        </main>\r\n        <!-- main container -->\r\n\r\n        <div class=\"gotop\"><span class=\"svg-icons i-arrow-up\"></span></div>\r\n    </div>\r\n    <!-- footer -->\r\n    <footer>\r\n        <div class=\"footer\">\r\n            <img src=\"image/01_index_01_logo.png\" alt=\"百老匯影城LOGO\" />\r\n            <div>\r\n                <a href=\"https://www.facebook.com/B.CINEMAS\" class=\"fb\">\