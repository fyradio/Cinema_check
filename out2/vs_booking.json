   "body": "\r\n<!DOCTYPE html>\r\n<html>\r\n  <head><!--[if lt IE 9]>\r\n    <script src=\"../js/html5.js\"></script><![endif]-->\r\n    <!-- mata資訊-->\r\n        <!-- meta [start]-->\r\n        <title>威秀影城 - 訂票</title>\r\n        <meta http-equiv=\"Cache-Control\" content=\"no-cache\">\r\n        <!-- meta [end]-->\r\n    \r\n<!-- meta [start]-->\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1, maximum-scale=1, user-scalable=yes\">\r\n<meta name=\"description\" content=\"威秀影城線上訂票系統。\">\r\n<meta name=\"keywords\" content=\"威秀, 威秀影城, 線上訂票, 電影訂票\">\r\n<meta name=\"author\" content=\"威秀影城線上訂票系統\">\r\n<meta name=\"copyright\" content=\"威秀影城線上訂票系統\">\r\n<meta name=\"Robots\" content=\"all\">\r\n<meta http-equiv=\"content-language\" content=\"zh-TW\">\r\n<meta name=\"revisit-after\" content=\"7 days\">\r\n<meta name=\"distribution\" content=\"GLOBAL\">\r\n<meta name=\"GOOGLEBOT\" content=\"index, follow\">\r\n<meta property=\"og:title\" content=\"威秀影城線上訂票系統\">\r\n<meta property=\"og:description\" content=\"威秀影城線上訂票系統。\">\r\n<meta property=\"og:site_name\" content=\"威秀影城線上訂票系統\">\r\n<meta property=\"og:type\" content=\"company\">\r\n<meta property=\"og:image\" content=\"https://www.unicornpopcorn.com.tw/ForVsWeb/images/thumbnail.jpg\">\r\n<link rel=\"image_src\" href=\"https://www.unicornpopcorn.com.tw/ForVsWeb/images/thumbnail.jpg\">\r\n<link rel=\"shortcut icon\" href=\"https://www.unicornpopcorn.com.tw/ForVsWeb/images/favicon.ico\">\r\n<!-- meta [end]-->\r\n<!-- Source [jquery] (lib)-->\r\n<script type=\"text/javascript\" src=\"https://www.unicornpopcorn.com.tw/ForVsTicket/js/jquery-2.1.0.min.js\"></script>\r\n<!-- [sticky] (For Movie List)-->\r\n<script type=\"text/javascript\" src=\"https://www.unicornpopcorn.com.tw/ForVsTicket/js/jquery.sticky.js\"></script>\r\n<!--use iframe-auto-height-->\r\n<script type=\"text/javascript\" src=\"https://www.unicornpopcorn.com.tw/ForVsTicket/js/jquery.iframe-auto-height.plugin.js